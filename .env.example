# Phazon Portal — Environment Configuration
# Copy to .env and fill in values. Never commit .env to source control.

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Ollama (local AI)
OLLAMA_URL=http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_LLM_MODEL=qwen3:8b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Authentication
# IMPORTANT: Generate a strong secret with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# Minimum 32 characters required in production.
JWT_SECRET=CHANGE-ME-generate-a-strong-random-secret

# Environment: 'development' or 'production'
# In production: CORS is restricted, HTTPS warning fires, weak JWT rejected
NODE_ENV=development

# Server
PORT=3001

# Production only:
# CORS_ORIGIN=https://your-frontend-domain.com
# VITE_API_BASE=https://api.your-domain.com/api
